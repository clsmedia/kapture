{
    "name": "clsmedia/kapture",
    "description": "Catch, log, and inspect every HTTP webhook in real time. A minimalist PHP webhook receiver with admin UI, JSONL logs, and zero dependencies.",
    "type": "project",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symplify/easy-coding-standard": "^12.0",
        "phpunit/phpunit": "^11.0",
        "zircote/swagger-php": "^6.6",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.0",
        "symfony/yaml": "^7.0",
        "opis/json-schema": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse",
        "ecs": "ecs check",
        "ecs:fix": "ecs check --fix",
        "test": "phpunit",
        "docs": "vendor/bin/openapi src -o public/openapi.json --version 3.1.0",
        "check": ["@phpstan", "@ecs", "@docs", "@test"]
    }
}
